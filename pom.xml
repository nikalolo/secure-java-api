<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- The parent pins versions for every Spring dependency we use,
         so we never write versions for starters ourselves. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>dev.nikalolo</groupId>
    <artifactId>secure-java-api</artifactId>
    <version>0.1.0</version>
    <name>secure-java-api</name>
    <description>A small Java API hardened step by step as a DevSecOps learning project</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Embedded Tomcat + Spring MVC + Jackson for JSON. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JUnit 5, MockMvc, AssertJ. Test scope: never shipped in the JAR. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Fixed JAR name so the Dockerfile doesn't depend on the version number. -->
        <finalName>app</finalName>
        <plugins>
            <!-- Repackages the JAR into an executable "fat JAR" (java -jar app.jar). -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
